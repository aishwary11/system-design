      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "left",
      "route": "straight"
    },
    {
      "id": "t2",
      "from": "running",
      "to": "analysis",
      "fromSide": "right",
      "toSide": "left",
      "route": "straight"
    },
    {
      "id": "t3",
      "from": "analysis",
      "to": "review",
